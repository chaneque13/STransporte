@page "/trailers"
@inject IDbContextFactory<AppDbContext> Factory

<PageTitle>Trailers</PageTitle>
<h1>Trailers</h1>

@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger">@error</div>
}

@if (editando is null)
{
    <button class="btn btn-primary mb-3" @onclick="Nuevo">Nuevo trailer</button>

    <table class="table table-striped align-middle">
        <thead>
            <tr><th>Placas</th><th>Tipo</th><th>Capacidad (ton)</th><th>Estado</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var t in lista)
            {
                <tr>
                    <td>@t.Placas</td>
                    <td>@t.TipoUnidad</td>
                    <td>@t.CapacidadTon.ToString("N2")</td>
                    <td>
                        <span class="badge @ClaseEstado(t.Estado)">@t.Estado</span>
                    </td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => Editar(t)">Editar</button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => Eliminar(t)">Eliminar</button>
                    </td>
                </tr>
            }
            @if (lista.Count == 0)
            {
                <tr><td colspan="5" class="text-muted">No hay trailers registrados.</td></tr>
            }
        </tbody>
    </table>
}
else
{
    <h4>@(editando.IdTrailer == 0 ? "Nuevo trailer" : "Editar trailer")</h4>
    <EditForm Model="editando" OnValidSubmit="Guardar" FormName="formTrailer">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label class="form-label">Placas</label>
            <InputText class="form-control" @bind-Value="editando.Placas" />
        </div>
        <div class="mb-3">
            <label class="form-label">Tipo de unidad</label>
            <InputSelect class="form-select" @bind-Value="editando.TipoUnidad">
                <option value="">-- Seleccione --</option>
                @foreach (var tipo in Estados.TiposUnidad)
                {
                    <option value="@tipo">@tipo</option>
                }
            </InputSelect>
        </div>
        <div class="mb-3">
            <label class="form-label">Capacidad (toneladas)</label>
            <InputNumber class="form-control" @bind-Value="editando.CapacidadTon" />
        </div>
        <div class="mb-3">
            <label class="form-label">Estado</label>
            <InputSelect class="form-select" @bind-Value="editando.Estado">
                @foreach (var e in Estados.Trailer)
                {
                    <option value="@e">@e</option>
                }
            </InputSelect>
        </div>

        <button type="submit" class="btn btn-success">Guardar</button>
        <button type="button" class="btn btn-secondary" @onclick="Cancelar">Cancelar</button>
    </EditForm>
}

@code {
    List<Trailer> lista = new();
    Trailer? editando;
    string? error;

    protected override async Task OnInitializedAsync() => await Cargar();

    async Task Cargar()
    {
        await using var db = await Factory.CreateDbContextAsync();
        lista = await db.Trailers.AsNoTracking().OrderBy(t => t.Placas).ToListAsync();
    }

    static string ClaseEstado(string estado) => estado switch
    {
        Estados.Disponible => "text-bg-success",
        Estados.TrailerEnRuta => "text-bg-warning",
        _ => "text-bg-secondary"
    };

    void Nuevo() { error = null; editando = new Trailer(); }

    void Editar(Trailer t)
    {
        error = null;
        editando = new Trailer
        {
            IdTrailer = t.IdTrailer, Placas = t.Placas, CapacidadTon = t.CapacidadTon,
            TipoUnidad = t.TipoUnidad, Estado = t.Estado
        };
    }

    void Cancelar() => editando = null;

    async Task Guardar()
    {
        error = null;
        try
        {
            await using var db = await Factory.CreateDbContextAsync();
            if (editando!.IdTrailer == 0) db.Trailers.Add(editando);
            else db.Trailers.Update(editando);
            await db.SaveChangesAsync();
            editando = null;
        }
        catch (DbUpdateException)
        {
            error = "No se pudo guardar. Verifique que las placas no estén repetidas.";
        }
        await Cargar();
    }

    async Task Eliminar(Trailer t)
    {
        error = null;
        try
        {
            await using var db = await Factory.CreateDbContextAsync();
            db.Trailers.Remove(t);
            await db.SaveChangesAsync();
        }
        catch (DbUpdateException)
        {
            error = $"No se puede eliminar el trailer '{t.Placas}' porque tiene viajes registrados.";
        }
        await Cargar();
    }
}
